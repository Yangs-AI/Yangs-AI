---
import SubpageLayout from "../../../layouts/SubpageLayout.astro";
import BackButton from "../../../components/BackButton.astro";
import { toolSections } from "../../../data/tools";

const toolsSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "url": "https://yangs.ai/resources/tools",
  "name": "Tools | Resources | Yangs AI",
  "description": "Tools developed by YangsAI and internal tools that assist research workflows.",
  "publisher": { "@id": "https://yangs.ai/#organization" },
  "hasPart": toolSections.flatMap((section) =>
    section.items.map((item) => ({
      "@type": "SoftwareApplication",
      "name": item.name,
      "description": item.description,
      "url": item.href,
    })),
  ),
};
---

<SubpageLayout title="Tools | Resources | Yangs AI" description="Tools developed by YangsAI and internal tools that assist research workflows." schema={toolsSchema}>
  <BackButton href="/" label="Back to Home" />
  <p class="font-tech mt-5 text-xs uppercase tracking-[0.12em] text-zinc-300">Resources</p>
  <h1 class="mt-3 text-4xl font-semibold tracking-tight text-zinc-100 md:text-5xl">Tools</h1>
  <p class="mt-4 max-w-3xl text-base leading-relaxed text-zinc-300">
    A curated list of tools: one track for tools we build and publish, and one track for internal tools used to boost research productivity.
  </p>

  <div class="mt-8 space-y-8">
    {toolSections.map((section) => (
      <section class="space-y-3" data-tool-section={section.key}>
        <div>
          <h2 class="font-tech text-sm uppercase tracking-[0.12em] text-zinc-200">{section.title}</h2>
          <p class="mt-1 text-sm text-zinc-300">{section.summary}</p>
        </div>

        <div class="grid gap-3 md:grid-cols-2">
          {section.items.map((item) => (
            <a
              href={item.href}
              target="_blank"
              rel="noreferrer"
              class="tool-card group rounded-xl border border-white/14 bg-white/5 p-4 transition hover:border-white/28 hover:bg-white/10"
            >
              <div class="flex items-start justify-between gap-3">
                <h3 class="tool-card-title text-base font-semibold text-zinc-100 group-hover:text-white">{item.name}</h3>
                <div class="flex flex-wrap justify-end gap-1.5">
                  <span class="tool-badge rounded-full border border-white/16 bg-white/8 px-2 py-0.5 text-[0.62rem] uppercase tracking-[0.1em] text-zinc-200">
                    Link
                  </span>
                  {item.internal ? (
                    <span class="tool-badge tool-badge-internal rounded-full border border-cyan-300/32 bg-cyan-300/12 px-2 py-0.5 text-[0.62rem] uppercase tracking-[0.1em] text-cyan-100">
                      Internal
                    </span>
                  ) : null}
                  {item.requiresAuthorization ? (
                    <span class="tool-badge tool-badge-auth rounded-full border border-amber-300/32 bg-amber-300/12 px-2 py-0.5 text-[0.62rem] uppercase tracking-[0.1em] text-amber-100">
                      Auth Required
                    </span>
                  ) : null}
                </div>
              </div>
              <p class="tool-card-description mt-2 text-sm leading-relaxed text-zinc-300">{item.description}</p>
              {item.authorizationNote ? (
                <p class="tool-card-auth-note mt-2 text-xs text-amber-200/90">{item.authorizationNote}</p>
              ) : null}
              <p class="tool-card-link mt-3 text-xs text-zinc-400 group-hover:text-zinc-300">{item.href}</p>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</SubpageLayout>

<style>
  :global(html[data-theme="light"] .tool-card) {
    border-color: rgba(51, 65, 85, 0.24);
    background: rgba(248, 251, 255, 0.96);
    box-shadow: 0 10px 24px rgba(98, 124, 158, 0.12);
  }

  :global(html[data-theme="light"] .tool-card:hover) {
    border-color: rgba(30, 64, 175, 0.34);
    background: rgba(237, 246, 255, 0.98);
  }

  :global(html[data-theme="light"] .tool-card-title) {
    color: #0f172a;
  }

  :global(html[data-theme="light"] .tool-card-description) {
    color: #334155;
  }

  :global(html[data-theme="light"] .tool-card-link) {
    color: #475569;
  }

  :global(html[data-theme="light"] .tool-card-auth-note) {
    color: #92400e;
  }

  :global(html[data-theme="light"] .tool-badge) {
    border-color: rgba(51, 65, 85, 0.24);
    background: rgba(241, 245, 249, 0.9);
    color: #1f2937;
  }

  :global(html[data-theme="light"] .tool-badge-internal) {
    border-color: rgba(8, 145, 178, 0.34);
    background: rgba(207, 250, 254, 0.96);
    color: #155e75;
  }

  :global(html[data-theme="light"] .tool-badge-auth) {
    border-color: rgba(217, 119, 6, 0.34);
    background: rgba(254, 243, 199, 0.98);
    color: #92400e;
  }
</style>
